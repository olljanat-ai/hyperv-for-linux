 .../firmware/efi/libstub/efi-mshv-common.c    | 135 ++++++++++++
 drivers/firmware/efi/libstub/efi-mshv.h       | 116 ++++++++++
 drivers/firmware/efi/libstub/efi-stub.c       |   5 +
 drivers/firmware/efi/libstub/fdt.c            |  14 +-
 drivers/firmware/efi/libstub/x86-efi-mshv.c   | 203 ++++++++++++++++++
 drivers/firmware/efi/libstub/x86-stub.c       |  15 +-
